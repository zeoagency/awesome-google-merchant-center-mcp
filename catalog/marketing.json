    {
      "name": "run_merchant_center_query",
      "description": "Runs one read-only Merchant Center Query Language (MCQL) SELECT query for advanced reporting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string"
          },
          "accountId": {
            "type": "string",
            "pattern": "^(accounts\\/)?\\d+$"
          },
          "query": {
            "type": "string",
            "minLength": 6,
            "maxLength": 12000
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "default": 1000
          },
          "pageToken": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "source": "https://github.com/MadMaxen92/marketing-mcp/blob/3b672ae7a9d708247e9dbe9073a2769740864f1a/src/mcp.ts#L427",
      "scope": "merchant",
      "operation": "read",
      "category": "reporting",
      "summary": "Runs one read-only Merchant Center Query Language (MCQL) SELECT query for advanced reporting.",
      "notes": [
        "Validation rejects mutation keywords and semicolons even inside quoted values; some valid SELECT queries are therefore rejected."
      ]
    }
