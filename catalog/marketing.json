    {
      "name": "get_merchant_product_status",
      "description": "Returns products with eligibility status, destination status, and item issues; supports optional filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string"
          },
          "accountId": {
            "type": "string",
            "pattern": "^(accounts\\/)?\\d+$"
          },
          "offerId": {
            "type": "string",
            "maxLength": 250
          },
          "status": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "ELIGIBLE_LIMITED",
              "PENDING",
              "NOT_ELIGIBLE_OR_DISAPPROVED"
            ]
          },
          "reportingContext": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "For example SHOPPING_ADS or FREE_LISTINGS."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "pageToken": {
            "type": "string"
          }
        },
        "required": [
          "accountId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "source": "https://github.com/MadMaxen92/marketing-mcp/blob/3b672ae7a9d708247e9dbe9073a2769740864f1a/src/mcp.ts#L373",
      "scope": "merchant",
      "operation": "read",
      "category": "diagnostics",
      "summary": "Returns products with eligibility status, destination status, and item issues; supports optional filters."
    },
